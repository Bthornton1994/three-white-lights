{
  "name": "three-white-lights-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite --host 127.0.0.1 --port 5173",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit --project tsconfig.test.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test:domain": "node --import tsx ../scripts/production-domain.mjs",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:unit:web": "vitest run --config vitest.config.ts",
    "test:browser": "node ../scripts/production-browser.mjs",
    "check": "npm run typecheck && npm run test:domain && npm run build && npm run test:browser"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.0.5",
    "playwright": "1.62.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "4.1.11"
  }
}
