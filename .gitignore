# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# CanvasKit WASM, copied out of node_modules by tools/dev-web.sh (~8MB)
public/canvaskit.wasm

# Subagent git worktrees (builder isolation)
.claude/worktrees/

# Run output: state.json is tracked (it drives the progress page); the
# generated page and the screenshot evidence are regenerable, so they are not.
.gauntlet/shots/
.gauntlet/progress.html
